NEXT_PUBLIC_SUPABASE_URL=https://yufptpfiwdbzzrvhkvux.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=https://creatorhub-gray.vercel.app
# Canonical OAuth callback origin. Keep this stable even when Vercel preview URLs change.
OAUTH_REDIRECT_ORIGIN=https://creatorhub-gray.vercel.app

# CreatorHub prefers CoOperative-managed inference when configured, then falls back to Vercel AI Gateway.
COOPERATIVE_INFERENCE_URL=
COOPERATIVE_INFERENCE_SECRET=

# Hosted-model fallback through Vercel AI Gateway/OIDC.
AI_GATEWAY_API_KEY=

# CreatorHub commerce. Buyers do not need a connected Stripe account.
# Stripe Connect will later be used only for creators/sellers who receive payouts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Instagram API with Instagram Login (professional creator/business accounts)
# Production redirect: https://creatorhub-gray.vercel.app/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

# TikTok Login Kit web OAuth
# Production redirect: https://creatorhub-gray.vercel.app/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic

# Fanvue OAuth (creator account + KYC + Fanvue Developer app required)
# Production redirect: https://creatorhub-gray.vercel.app/api/oauth/fanvue/callback
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_SCOPES=openid offline_access offline read:self

# Eromify remote MCP connector. Personal API keys are created in Eromify Settings → Claude/MCP.
# Keep EROMIFY_API_KEY server-only. CreatorHub uses tools/list for non-generative capability checks.
EROMIFY_MCP_URL=https://api.eromify.in/mcp
EROMIFY_API_KEY=

# Paper Trading Lab / PAPER execution credentials. The execution endpoint is hard-wired to Alpaca's paper host.
# Never expose these as NEXT_PUBLIC variables.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Separate server-only authorization token for privileged swing PAPER submission.
# Keep unset to make the endpoint unavailable.
PAPER_SWING_EXECUTION_TOKEN=

# Vercel environment-variable changes require a fresh deployment.
